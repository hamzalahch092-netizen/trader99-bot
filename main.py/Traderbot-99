import asyncio,os,json,time
import numpy as np,pandas as pd
import aiohttp
from datetime import datetime,timezone

T=os.getenv("TG_TOKEN","")
A=os.getenv("PO_ASSET","eurusd")
B=float(os.getenv("PO_BANK",50))
SK=float(os.getenv("PO_STAKE",0.20))
CF=float(os.getenv("PO_CONF",0.76))
MT=int(os.getenv("PO_MAXT",35))
MD=float(os.getenv("PO_MDX",0.25))
VM=float(os.getenv("PO_VOL",12.0))
bank=B;n=0;stop=False;cid=""

def rsi(c,p=14):
    d=np.diff(c[-p-1:])
    g=np.where(d>0,d,0);l=np.where(d<0,-d,0)
    a=float(np.mean(g));b=float(np.mean(l))
    return 100 if not b else 100-100/(1+a/b)
def macd(c):
    s=pd.Series(c)
    return float(s.ewm(span=12).mean().iloc[-1]-s.ewm(span=26).mean().iloc[-1])
def boll(c,p=20,k=2):
    s=pd.Series(c);m=float(s.rolling(p).mean().iloc[-1])
    sd=float(s.rolling(p).std().iloc[-1])
    if not sd:return .5
    return max(0,min(1,(float(c[-1])-(m-k*sd))/(2*k*sd)))
def atr(c,h,l,p=14):
    tr=np.maximum(h[1:]-l[1:],np.maximum(np.abs(h[1:]-c[:-1]),np.abs(l[1:]-c[:-1])))
    a=float(np.mean(tr[-p:]))
    return a/np.mean(c[-30:])*1e4 if len(c)>30 else 0

async def tg(t):
    if not cid:return
    async with aiohttp.ClientSession() as c:
        await c.post(f"https://api.telegram.org/bot{T}/sendMessage",json={"chat_id":cid,"text":t,"parse_mode":"HTML"})

async def sig():
    now=time.time();s=now//300*300
    try:
        async with aiohttp.ClientSession() as c:
            r=await c.post("https://ws.pocketoption.com/public/v1/trade/get_history",
                json={"asset_id":A,"timeframe":TF,"start":s-900,"end":now,"limit":300},timeout=10)
            j=(await r.json()).get("payload",{}).get("history",{})
            if not j:return None
            keys=sorted(j.keys())
            o=[float(j[k]["open"]) for k in keys]
            hh=[float(j[k]["high"]) for k in keys]
            ll=[float(j[k]["low"]) for k in keys]
            c=[float(j[k]["close"]) for k in keys]
            up=o[-60][-1]>o[-1] if False else np.polyfit(np.arange(len(c[-30:])),np.array(c[-30:]),1)[0]>0
            v=atr(c,hh,ll)
            bl=int(macd(c)>0)+int(rsi(c)>55)+int(boll(c)>.6)
            sl=int(macd(c)<0)+int(rsi(c)<45)+int(boll(c)<.4)
            if bl>=2 and up and cf:=max(.5,min(1,(bl/3)*(.9 if up else .7)))>=CF and v>VM:
                return "CALL",round(cf,2),v
            if sl>=2 and not up and cf:=max(.5,min(1,(sl/3)*(.9 if up else .7)))>=CF and v>VM:
                return "PUT",round(cf,2),v
            return None
    except:return None

async def loop():
    global cid,bank,n,stop
    while True:
        try:
            async with aiohttp.ClientSession() as c:
                j=(await (await c.get(f"https://api.telegram.org/bot{T}/getUpdates")).json()).get("result",[])
                if j:
                    for m in j:
                        msg=m["message"]["text"].strip()
                        cid=m["chat"]["id"]
                        if msg=="/start":
                            bank=B;n=0;stop=False
                            await tg(f"Trader99 ONLINE\nbank ${bank:.2f} | {A.upper()} 5m\nconf>{CF} | max {MT}T/d | dd<{int(MD*100)}%\nwaiting market")
                        elif msg=="/ping":
                            await tg(f"pong | Trader99 | bank ${bank:.2f} | trades {n}/{MT}")
                        elif msg=="/balance":
                            await tg(f"bank ${bank:.2f} | trades {n}/{MT}")
                        elif msg=="/stop":
                            stop=True;await tg("Trader99 STOPPED")
                        elif msg=="/restart":
                            bank=B;n=0;stop=False;await tg("Trader99 RESTARTED | bank ${bank:.2f}")
        except:pass
        if not stop and n<MT and bank>B*(1-MD):
            r=await sig()
            if r and time.time()//300!=last:
                side,cfv,vol=r
                n+=1;st=bank*SK;last=time.time()//300
                await tg(f"signal | {side} | {A.upper()} 5m\nconf {cfv} | vol {vol:.1f}\nstake ${st:.2f}")
                await asyncio.sleep(300)
                await tg(f"result | {side} | ${bank:.2f}")
        await asyncio.sleep(20)

import numpy as np,pandas as pd
last=0
asyncio.run(loop())
