import asyncio,os
import numpy as np,pandas as pd
import aiohttp

TOKEN=os.getenv("TG_TOKEN","")
EMAIL=os.getenv("PO_EMAIL","")
PWD=os.getenv("PO_PASS","")
ASSET=os.getenv("PO_ASSET","eurusd")
TF_M=int(os.getenv("PO_TF",5))
STAKE=float(os.getenv("PO_STAKE",0.20))
CONF_T=float(os.getenv("PO_CONF",0.76))
MAX_T=int(os.getenv("PO_MAXT",35))
MAX_DD=float(os.getenv("PO_MDX",0.25))
VOL_MIN=float(os.getenv("PO_VOL",12.0))
INIT_B=float(os.getenv("PO_BANK",50))

class R:
    def __init__(s,b):s.init=b;s.b=b;s.n=0
    def ok(s):return s.n<MAX_T and s.b>s.init*(1-MAX_DD)
    def tk(s,w):
        if not s.ok():return None
        st=s.b*STAKE;s.n+=1
        if w:s.b+=st*.8;return st*.8
        s.b-=st;return -st

async def tg(t,cid):
    async with aiohttp.ClientSession() as c:
        await c.post(f"https://api.telegram.org/bot{TOKEN}/sendMessage",json={"chat_id":cid,"text":t,"parse_mode":"HTML"})

async def discover():
    async with aiohttp.ClientSession() as c:
        while True:
            r=await c.get(f"https://api.telegram.org/bot{TOKEN}/getUpdates")
            j=(await r.json()).get("result",[])
            if j:return j[-1]["message"]["chat"]["id"]
            await asyncio.sleep(3)

async def main():
    cid=await discover()
    r=R(INIT_B)
    await tg(f"TRADER99 ONLINE | bank ${r.b:.2f} | {ASSET.upper()} {TF_M}m",cid)
    print("READY")

if __name__ == "__main__":
    asyncio.run(main())
